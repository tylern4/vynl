# Copy this file to .env and adjust values before running `docker compose up`.

# Postgres credentials (used by the db container and by the backend)
POSTGRES_USER=vynl
POSTGRES_PASSWORD=vynl
POSTGRES_DB=vynl

# Secret used to sign JWT auth tokens. Set a long random string in production.
JWT_SECRET=change-me-in-production

# Registration code. Anyone registering must supply this so only you can
# create accounts. Share it privately.
INVITE_CODE=change-me

# Contact email sent with MusicBrainz API requests (their policy requires
# a way to reach the app operator). Optional but strongly recommended.
MUSICBRAINZ_CONTACT=you@example.com
