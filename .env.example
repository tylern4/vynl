# Copy this file to .env and adjust values before running `docker compose up`.

# Postgres credentials (used by the db container and by the backend)
POSTGRES_USER=vynl
POSTGRES_PASSWORD=vynl
POSTGRES_DB=vynl

# Secret used to sign JWT auth tokens. Set a long random string in production.
JWT_SECRET=change-me-in-production

# Registration code. Anyone registering must supply this so only you can
# create accounts. Share it privately.
INVITE_CODE=change-me

# Contact email sent with MusicBrainz API requests (their policy requires
# a way to reach the app operator). Optional but strongly recommended.
MUSICBRAINZ_CONTACT=you@example.com

# Discogs personal access token. OPTIONAL — leave blank (or unset) to disable
# the Discogs provider entirely: search results simply omit Discogs rows and
# importing from Discogs fails gracefully.
#
# How to get one:
#   1. Sign in at https://www.discogs.com
#   2. Open https://www.discogs.com/settings/developers
#      (or: your avatar → Settings → Developers)
#   3. Click "Generate new token" and copy the value into DISCOGS_TOKEN below.
DISCOGS_TOKEN=

# iTunes storefronts queried on every search, comma-separated (order = query
# order). Each country adds ~0.3 s per search; the default covers the US, Japan
# (obscure/JP-only pressings) and the UK. Override for e.g. US,JP,GB,DE,FR.
ITUNES_COUNTRIES=US,JP,GB
